<?xml version="1.0" ?>

<robot name="cf2x250">

  <!-- 250 g quad, 119 mm diagonal motor spacing, 200 gf per motor at 30000 RPM -->
  <properties arm="0.05955" kf="2.18e-9" km="5.48e-11" thrust2weight="3.2" max_speed_kmh="45" gnd_eff_coeff="11.36859" prop_radius="2.5e-2" drag_coeff_xy="9.1785e-7" drag_coeff_z="10.311e-7" dw_coeff_1="2267.18" dw_coeff_2=".16" dw_coeff_3="-.11" />

  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="2.17e-4" ixy="0.0" ixz="0.0" iyy="2.17e-4" iyz="0.0" izz="3.80e-4"/>
    </inertial>
    <visual>
      <origin rpy="0 0 55" xyz="0 0 0"/>
      <geometry>
        <mesh filename="./cf2.dae" scale="1.5 1.5 1.5"/>
      </geometry>
      <material name="grey">
        <color rgba=".5 .5 .5 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius=".06" length=".035"/>
      </geometry>
    </collision>
  </link>

  <link name="prop0_link"><inertial><origin rpy="0 0 0" xyz="0.0421 -0.0421 0"/><mass value="0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial></link>
  <joint name="prop0_joint" type="fixed"><parent link="base_link"/><child link="prop0_link"/><origin xyz="0.0421 -0.0421 0" rpy="0 0 0"/></joint>
  <link name="prop1_link"><inertial><origin rpy="0 0 0" xyz="-0.0421 -0.0421 0"/><mass value="0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial></link>
  <joint name="prop1_joint" type="fixed"><parent link="base_link"/><child link="prop1_link"/><origin xyz="-0.0421 -0.0421 0" rpy="0 0 0"/></joint>
  <link name="prop2_link"><inertial><origin rpy="0 0 0" xyz="-0.0421 0.0421 0"/><mass value="0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial></link>
  <joint name="prop2_joint" type="fixed"><parent link="base_link"/><child link="prop2_link"/><origin xyz="-0.0421 0.0421 0" rpy="0 0 0"/></joint>
  <link name="prop3_link"><inertial><origin rpy="0 0 0" xyz="0.0421 0.0421 0"/><mass value="0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial></link>
  <joint name="prop3_joint" type="fixed"><parent link="base_link"/><child link="prop3_link"/><origin xyz="0.0421 0.0421 0" rpy="0 0 0"/></joint>

  <link name="center_of_mass_link"><inertial><origin rpy="0 0 0" xyz="0 0 0"/><mass value="0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial></link>
  <joint name="center_of_mass_joint" type="fixed"><parent link="base_link"/><child link="center_of_mass_link"/></joint>

</robot>
